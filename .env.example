# Copy to .env and adjust. Do not commit secrets.

# Mode: dev | prod  (flags: -mode=dev -url=...)
FLOW_MODE=dev
FLOW_URL=http://localhost:5173

FLOW_HTTP_ADDR=:8080
FLOW_LOG_LEVEL=info

FLOW_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/flow?sslmode=disable
FLOW_REDIS_URL=redis://127.0.0.1:6379

# Extra origins, comma-separated. FLOW_URL is always included.
FLOW_CORS_ORIGINS=

# Reverse proxies (CIDRs or bare IPs), comma-separated, allowed to set
# X-Forwarded-For for client-IP logging/rate-limiting. Leave empty (default)
# unless Flow sits behind a proxy/load balancer you control -- otherwise any
# client can spoof its own IP in login_attempts/auth_events.
FLOW_TRUSTED_PROXIES=

FLOW_SESSION_SECRET=change-me

FLOW_SHUTDOWN_TIMEOUT=15s
FLOW_HTTP_READ_TIMEOUT=10s
FLOW_HTTP_WRITE_TIMEOUT=30s
FLOW_HTTP_IDLE_TIMEOUT=60s
FLOW_HTTP_MAX_HEADER_BYTES=1048576

FLOW_S3_ENDPOINT=http://127.0.0.1:3900
FLOW_S3_REGION=garage
FLOW_S3_BUCKET=flow
FLOW_S3_ACCESS_KEY=
FLOW_S3_SECRET_KEY=
FLOW_S3_USE_PATH_STYLE=true

FLOW_MAIL_FROM=
FLOW_MAIL_FROM_NAME=Flow
FLOW_MAIL_SMTP_HOST=smtp.hostinger.com
FLOW_MAIL_SMTP_PORT=465
FLOW_MAIL_SMTP_USER=
FLOW_MAIL_SMTP_PASSWORD=
FLOW_MAIL_SMTP_ENCRYPTION=ssl
